# =====================================================================
# Overleaf CV Agent Configuration
# =====================================================================

# [REQUIRED] Overleaf session cookie ('overleaf_session2' from browser cookies)
OVERLEAF_SESSION='s%3A...'

# [REQUIRED] Overleaf Project ID (from https://www.overleaf.com/project/<PROJECT_ID>)
OVERLEAF_PROJECT_ID='your_overleaf_project_id_here'

# [OPTIONAL] Candidate Name used as the prefix for generated PDFs
# Defaults to 'Candidate' if not specified
CANDIDATE_NAME='Your_Name'

# [OPTIONAL] PDF filename naming template
# Available placeholders: {name}, {role}
# Defaults to: {name}_Your_Next_{role}.pdf
CV_NAMING_TEMPLATE='{name}_Your_Next_{role}.pdf'

# [OPTIONAL] Enforce maximum filename character length (0 = no limit)
# Defaults to: 0
MAX_FILENAME_LENGTH=0

